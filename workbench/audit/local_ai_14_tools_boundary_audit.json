  "part_2_pull_request_assertion_weakening_audit": {
    "total_single_parent_pull_requests_audited": 179253,
    "audit_scope": "Empirical AST and diff audit of 179,253 single parent pull requests across public open source repositories comparing coding agent patches and human patches touching test files.",
    "weakening_operators_tracked": [
      "assertion_deleted",
      "skip_or_xfail_decorator_added",
      "expected_tolerance_widened",
      "exception_swallowed_in_test"
    ],
    "key_findings": {
      "human_parity_weakening_rate": "Coding agents weakened test assertions at approximately the same rate as human authors across single parent PRs touching tests, demonstrating that green workspace test suites are an insufficient proof of task completion regardless of author.",
      "frozen_check_necessity": "When test files reside inside the agent's writable workspace, a 1.5B to 9B model can turn the test suite green by deleting or relaxing an assertion while leaving the underlying SQLite database or record in an unfixed state (such as 13 instead of 42).",
      "design_consequence_in_picchio": "Picchio freezes original acceptance tests outside the writable workspace under root or separate permissions and queries the final SQLite ledger through an independent read only connection with PRAGMA query_only=ON."
    }
  }
