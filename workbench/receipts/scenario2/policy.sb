(version 1)
(deny default)
(allow process-fork)
(allow sysctl-read)
(allow mach-lookup)
(allow iokit-open)
(allow file-read-metadata)
(allow file-read* (literal "/"))
(allow signal (target same-sandbox))
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/usr/lib"))
(allow file-read* (subpath "/usr/share"))
(allow file-read* (subpath "/usr/bin"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/sbin"))
(allow file-read* (subpath "/Library/Apple"))
(allow file-read* (subpath "/Library/Preferences/Logging"))
(allow file-read* (subpath "/private/var/db"))
(allow file-read* (subpath "/opt/homebrew/bin"))
(allow file-read* (subpath "/opt/homebrew/Cellar"))
(allow file-read* (subpath "/opt/homebrew/opt"))
(allow file-read* (subpath "/opt/homebrew/lib"))
(allow file-read* (subpath "/workspace/mozilla-humanscale/workbench/runner/humanscale"))
(allow file-read* (subpath "/workspace/mozilla-humanscale/workbench/receipts/scenario2/workspace"))
(allow file-read* (literal "/workspace/mozilla-humanscale/workbench/models/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf"))
(allow file-read* (literal "/dev/null") (literal "/dev/urandom") (literal "/dev/random"))
(allow file-write* (literal "/dev/null") (subpath "/workspace/mozilla-humanscale/workbench/receipts/scenario2/workspace"))
(allow process-exec (subpath "/opt/homebrew/Cellar") (subpath "/opt/homebrew/opt") (literal "/usr/bin/env"))
(allow network-bind (local ip "localhost:51623"))
(allow network-inbound (local ip "localhost:51623"))
(allow network-outbound (remote ip "localhost:51623"))
